# Required model credential for both `make zhiwo-run` and Docker Compose.
DEEPSEEK_API_KEY=your_key

# Browser-facing authority for this deployment (host or host:port, without a scheme).
ZHIWO_TRUSTED_HOST=your-host.example

# Optional Host path for direct `docker compose` deployment; defaults to ./userdata.
# ZHIWO_USERDATA=/absolute/materials
